# LiveCoachHub — Environment Variables Example
# Copy this file to .env and fill in the values.

# LLM Provider: "gemini" or "qlora" (default: gemini)
LLM_PROVIDER=gemini

# Gemini API Keys — comma-separated untuk auto-rotation saat rate limit
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/
# Contoh multi-key: GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3
GEMINI_API_KEYS=

# Gemini Model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# NLP Service URL (default: http://localhost:8010)
NLP_SERVICE_URL=http://localhost:8010

# Local QLoRA Service URL (default: http://localhost:8020, only used in qlora mode)
LLM_SERVICE_URL=http://localhost:8020
