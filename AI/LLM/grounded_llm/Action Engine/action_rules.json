{
  "schema_version": "action_rules.v3",
  "note": "Aturan deterministik pasca-NLP. Intent spesifik IndoBERT dipertahankan sebagai normalized semantic signal; dominance audiens menjadi ranking utama dan business priority hanya tie-break terakhir.",

  "threshold_policy": {
    "description": "Sinyal minimal sebelum Action Engine berani memilih action selain NO_ACTION.",
    "min_supporting_comments_60s": 2,
    "min_unique_users_60s": 2,
    "min_state_confidence": 0.7,
    "mode": "AND"
  },

  "tie_break_policy": {
    "description": "Urutkan signal eligible berdasarkan unique users, support, confidence, lalu business priority.",
    "order": ["unique_user_count_desc", "support_count_desc", "state_confidence_desc", "priority_rank_asc"]
  },

  "stability_policy": {
    "description": "Pertahankan main signal selama masih eligible kecuali challenger memiliki setidaknya dua unique user lebih banyak.",
    "switch_unique_user_margin": 2
  },

  "audience_states": [
    {
      "state": "SIZE_INFORMATION_GAP",
      "priority_rank": 1,
      "source_intents": ["SIZE_AVAILABILITY"],
      "selected_action": "SHOW_SIZE_OPTIONS",
      "required_fact_types": ["SIZE_GUIDE"],
      "required_fact_query": {"fact_type": "SIZE_GUIDE", "topic": "size_options"},
      "reason_template": "{support_count} pertanyaan pilihan ukuran muncul dalam 60 detik terakhir."
    },
    {
      "state": "SIZE_FRICTION",
      "priority_rank": 2,
      "source_intents": ["SIZE_RECOMMENDATION"],
      "selected_action": "SHOW_SIZE_GUIDE",
      "required_fact_types": ["SIZE_GUIDE"],
      "required_fact_query": {"fact_type": "SIZE_GUIDE", "topic": "size_recommendation"},
      "reason_template": "{support_count} permintaan rekomendasi ukuran muncul dalam 60 detik terakhir."
    },
    {
      "state": "COLOR_INFORMATION_GAP",
      "priority_rank": 3,
      "source_intents": ["COLOR_AVAILABILITY"],
      "selected_action": "SHOW_COLOR_OPTIONS",
