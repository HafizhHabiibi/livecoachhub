    },
    {
      "state": "STOCK_FRICTION",
      "priority_rank": 4,
      "source_intents": ["STOCK_AVAILABILITY"],
      "selected_action": "CONFIRM_STOCK",
      "required_fact_types": ["STOCK"],
      "required_fact_query": {"fact_type": "STOCK", "topic": "stock_availability"},
