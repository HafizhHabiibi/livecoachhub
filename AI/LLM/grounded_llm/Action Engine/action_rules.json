      "required_fact_query": {"fact_type": "PRODUCT_DETAIL", "topic": "product_detail"},
      "reason_template": "{support_count} pertanyaan detail produk (bahan/deskripsi/perawatan) muncul dalam 60 detik terakhir."
    },
    {
      "state": "PRICE_FRICTION",
      "priority_rank": 6,
      "source_intents": ["PRICE_PROMO"],
      "selected_action": "EXPLAIN_PRICE_PROMO",
      "required_fact_types": ["PRICE_PROMO"],
      "required_fact_query": {"fact_type": "PRICE_PROMO", "topic": "price_promo"},
      "reason_template": "{support_count} pertanyaan harga/promo muncul dalam 60 detik terakhir."
    }
  ],

  "not_yet_implemented": {
